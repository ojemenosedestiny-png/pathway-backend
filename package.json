{
  "name": "pathway-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "generate": "prisma generate",
    "migrate": "npm run db:setup",
    "seed": "tsx prisma/seed.ts",
    "test": "node ops/test-mongodb.mjs",
    "format": "prettier --write src test prisma/seed.ts *.md *.json compose.yaml",
    "format:check": "prettier --check src test prisma/seed.ts *.md *.json compose.yaml",
    "docs:export": "node ops/export-contract.mjs",
    "db:setup": "tsx prisma/setup-mongodb.ts",
    "test:direct": "tsx --test test/*.test.ts",
    "migrate:phase2": "tsx prisma/migrate-phase2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "22.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "sanitize-html": "^2.17.0",
    "stripe": "^18.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^18.1.0-beta.15",
    "prettier": "^3.6.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
