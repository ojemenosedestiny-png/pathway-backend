NODE_ENV=development
PORT=4000
# Testing: process queued jobs in the API while awake. Use false with a separate worker.
RUN_WORKER_IN_API=false
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/pathway?retryWrites=true&w=majority
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:4000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Exactly 32 random bytes encoded as 64 hex characters. Keep backed up separately.
ENCRYPTION_KEY=
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
STUDENT_ID_PREFIX=PU
STUDENT_ID_START=1
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
TERMII_API_KEY=
TERMII_SENDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_NOTICE_TEMPLATE=
WHATSAPP_LANGUAGE=en
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_MEDIA_BASE=
# Authenticated scanner HTTP endpoint: POST raw file -> {"clean":true|false}
SCANNER_URL=
SCANNER_TOKEN=
